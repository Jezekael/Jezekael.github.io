---
layout: null
sitemap: false
---
{%- comment -%}
  Generated at build time from projects/research/wwta/incidents/*.md and
  projects/research/wwta/groups/*.md. Read by the map, the actor table and the attack log.
{%- endcomment -%}
{%- assign groups = site.pages | where: "layout", "group" | sort: "title" -%}
{%- assign incidents = site.pages | where: "layout", "incident" | sort: "date" | reverse -%}
{
  "groups": [
    {%- for g in groups %}
    {
      "id": {{ g.name | remove: ".md" | jsonify }},
      "url": {{ g.url | relative_url | jsonify }},
      "name": {{ g.title | jsonify }},
      "country": {{ g.country | jsonify }},
      "objective": {{ g.objective | jsonify }},
      "status": {{ g.status | jsonify }},
      "summary": {{ g.description | jsonify }},
      "aliases": {{ g.aliases | jsonify }},
      "focus_areas": {{ g.focus_areas | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ],
  "incidents": [
    {%- for i in incidents %}
    {%- assign g_file = i.group | append: ".md" %}
    {%- assign g = groups | where: "name", g_file | first %}
    {
      "id": {{ i.name | remove: ".md" | jsonify }},
      "url": {{ i.url | relative_url | jsonify }},
      "title": {{ i.title | jsonify }},
      "date": {{ i.date | date: "%Y-%m-%d" | jsonify }},
      "group": {{ i.group | jsonify }},
      "group_name": {{ g.title | default: i.group | jsonify }},
      "region": {{ i.region | jsonify }},
      "target": {{ i.target | jsonify }},
      "summary": {{ i.description | jsonify }},
      "description": {{ i.content | strip_html | strip | jsonify }},
      "coordinates": {{ i.coordinates | jsonify }},
      "techniques": {{ i.techniques | jsonify }},
      "tags": {{ i.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
